// 이 파일을 appsettings.local.json 으로 복사해 로컬 오버라이드를 둔다.
// appsettings.local.json 은 .gitignore 대상 — 커밋되지 않는다.
// (AWS 자격증명은 여기 두지 말 것. `aws configure` / 환경변수 / IAM 역할 사용)
{
  // 서버가 다른 PC에 있으면 IngestionEndpoint를 바꾼다.
  // BearerToken은 서버가 Auth:Mode=jwt 로 돌 때만 필요하다.
  "Server": {
    "IngestionEndpoint": "http://127.0.0.1:5080",
    "BearerToken": "",
    "UserId": "developer",
    "TenantId": "default"
  },

  // Bedrock을 쓸 때만 필요하다. inference profile ID(us./global. 접두)여야 한다.
  "Aws": {
    "Region": "us-east-1",
    "BedrockModelId": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
  },

  // Bedrock 대신 다른 공급자를 쓸 때. 서버의 Llm:Provider 와 짝을 맞춘다.
  "Llm": {
    "Vertex": {
      "ProjectId": "my-gcp-project",
      "Location": "us-central1",
      "Model": "gemini-2.5-flash"
    },
    "AzureOpenAI": {
      "Endpoint": "https://<resource>.openai.azure.com",
      "Deployment": "<deployment>",
      "ApiVersion": "2024-10-21",
      "ApiKey": "",
      "BearerToken": ""
    }
  },

  // 관측 제외 목록. 매 회차 다시 평가되므로 --watch 도중에 옮겨가도 그 회차부터 막힌다.
  "Consent": {
    "Enabled": true,
    "ExcludedApps": [],
    "ExcludedUrlPatterns": []
  }
}
