// 이 파일을 appsettings.local.json 으로 복사해 로컬 오버라이드를 둔다.
// appsettings.local.json 은 .gitignore 대상 — 커밋되지 않는다.
// (AWS 자격증명은 여기 두지 말 것. `aws configure` / 환경변수 / IAM 역할 사용)
{
  // 서버가 다른 PC에 있을 때만 채운다. 비우면 http://127.0.0.1:5080 을 쓴다.
  "Server": {
    "IngestionEndpoint": ""
  },

  // --bedrock 을 쓸 때만 필요하다. inference profile ID(us./global. 접두)여야 한다.
  "Aws": {
    "Region": "us-east-1",
    "BedrockModelId": "us.anthropic.claude-haiku-4-5-20251001-v1:0"
  },

  // 관측 제외 목록. 매 회차 다시 평가되므로 --watch 도중에 옮겨가도 그 회차부터 막힌다.
  "Consent": {
    "Enabled": true,
    "ExcludedApps": [],
    "ExcludedUrlPatterns": []
  }
}
